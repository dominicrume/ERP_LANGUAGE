# Copy to .env for local use. Nothing here is a secret yet, because the app
# has no accounts; that changes the day identity lands (DEBT.md).

# Where learner records live. SQLite by default, any SQLAlchemy DSN works.
# ERPSIM_DATABASE_URL=postgresql+psycopg://erpsim:erpsim@localhost:5432/erpsim

# Send Strict-Transport-Security. Only true when the app is behind TLS.
# ERPSIM_HTTPS_ONLY=false

# Serve the interactive API docs at /docs and /redoc.
# ERPSIM_PUBLIC_DOCS=true

# Writes allowed per client per minute. 0 disables the in-process limiter,
# which is what you want when a real gateway is doing it instead.
# ERPSIM_WRITE_LIMIT_PER_MINUTE=120

# Largest request body accepted, in bytes.
# ERPSIM_MAX_BODY_BYTES=262144
